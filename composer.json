{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alirashidnahal/polytext",
    "description": "Framework-agnostic PHP library for parsing, reading, and writing text across many file formats.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "file",
        "parser",
        "docx",
        "xlsx",
        "pdf",
        "subtitle",
        "polytext"
    ],
    "authors": [
        {
            "name": "Ali Rashidnahal",
            "homepage": "https://github.com/alirashidnahal"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "league/csv": "^9.27",
        "phpoffice/phppresentation": "dev-master as 1.3.0",
        "phpoffice/phpspreadsheet": "^5.10",
        "phpoffice/phpword": "^1.4.0",
        "smalot/pdfparser": "^2.13",
        "symfony/yaml": "^7.2|^8.0"
    },
    "require-dev": {
        "illuminate/support": "^13.0",
        "laravel/pint": "^1.32",
        "phpstan/1phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Alirashidnahal\\Polytext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alirashidnahal\\Polytext\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Alirashidnahal\\Polytext\\Laravel\\PolytextServiceProvider"
            ],
            "aliases": {
                "Polytext": "Alirashidnahal\\Polytext\\Laravel\\Facades\\Polytext"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit --colors=always",
        "test:coverage": "phpunit --colors=always --coverage-text",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test"
    },
    "suggest": {
        "illuminate/support": "Required for the optional Laravel bridge (^13.0)."
    }
}
